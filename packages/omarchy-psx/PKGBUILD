prepare() {
  [[ $(git -C "$srcdir/omarchy" rev-parse HEAD) == "$_commit" ]]
  install -m644 "$srcdir/console-autostart.lua" "$srcdir/omarchy/config/hypr/autostart.lua"
  install -m644 "$srcdir/console-autostart.lua" "$srcdir/omarchy/default/hypr/autostart.lua"
  sed -i 's/org\.gnome\.Nautilus\.desktop/thunar.desktop/g' \
    "$srcdir/omarchy/default/applications/mimeapps.list"
}

package_omarchy-psx() {
  provides=('omarchy')
  conflicts=('omarchy' 'omarchy-dev' 'omarchy-ps4')
  depends=('fakeroot' 'git' 'gnome-keyring' 'gum' 'hyprland' 'jq'
           'omarchy-psx-settings=4.0.0-1' 'pacman-contrib' 'perl' 'pipewire'
           'quickshell' 'ttf-jetbrains-mono-nerd-basic' 'thunar' 'uwsm'
           'wireplumber' 'xdg-desktop-portal-hyprland')
  cd "$srcdir/omarchy"
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/lib/omarchy-psx/upstream-bin" \
    "$pkgdir/usr/share/omarchy/bin"
  for binary in bin/*; do
    [[ -f $binary ]] || continue
    name=${binary##*/}
    install -Dm755 "$binary" "$pkgdir/usr/lib/omarchy-psx/upstream-bin/$name"
    case $name in
      omarchy-debug|omarchy-debug-idle|omarchy-upload-log) continue ;;
      omarchy-launch-nautilus|omarchy-launch-nautilus-cwd)
        install -Dm755 "$srcdir/$name" "$pkgdir/usr/bin/$name" ;;
      *)
        if grep -Fxq "$name" "$srcdir/console-disabled-commands.txt" || [[ $name == omarchy-update* ]]; then
          install -Dm755 "$srcdir/omarchy-psx-unavailable" "$pkgdir/usr/bin/$name"
        else
          install -Dm755 "$binary" "$pkgdir/usr/bin/$name"
        fi ;;
    esac
    ln -s "/usr/bin/$name" "$pkgdir/usr/share/omarchy/bin/$name"
  done
  cp -a install migrations shell themes "$pkgdir/usr/share/omarchy/"
  install -Dm644 version "$pkgdir/usr/share/omarchy/version"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omarchy-psx/LICENSE"
  install -Dm644 "$srcdir/console-disabled-commands.txt" "$pkgdir/usr/share/omarchy-psx/disabled-commands.txt"
  printf '%s\n' "$_commit" >"$pkgdir/usr/share/omarchy-psx/upstream-commit"
  install -d "$pkgdir/etc/skel/.local/state/omarchy/migrations"
  for migration in migrations/*.sh; do
    touch "$pkgdir/etc/skel/.local/state/omarchy/migrations/${migration##*/}"
  done
}

package_omarchy-psx-settings() {
  provides=('omarchy-settings')
  conflicts=('omarchy-settings' 'omarchy-settings-dev' 'omarchy-ps4-settings')
  depends=('bash' 'curl' 'gum' 'hicolor-icon-theme' 'sddm')
  cd "$srcdir/omarchy"
  install -d "$pkgdir/etc/skel/.config" "$pkgdir/usr/share/omarchy/config" \
    "$pkgdir/usr/share/omarchy/default" "$pkgdir/usr/share/omarchy/applications" \
    "$pkgdir/etc/skel/.local/share/applications"
  cp -a config/. "$pkgdir/etc/skel/.config/"
  cp -a config/. "$pkgdir/usr/share/omarchy/config/"
  cp -a default/. "$pkgdir/usr/share/omarchy/default/"
  cp -a applications/. "$pkgdir/usr/share/omarchy/applications/"
  cp applications/*.desktop "$pkgdir/etc/skel/.local/share/applications/"
  for icon in applications/icons/*; do
    [[ -f $icon ]] || continue
    icon_name=${icon##*/}
    icon_id=$(printf '%s\n' "${icon_name%.*}" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
    if [[ $icon_name == *.svg ]]; then
      install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon_id.svg"
    else
      for size in 48 256; do
        install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
        magick "$icon" -thumbnail "${size}x${size}" -background transparent -gravity center \
          -extent "${size}x${size}" "PNG32:$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$icon_id.png"
      done
    fi
  done
  install -Dm644 default/uwsm/env.d/10-omarchy "$pkgdir/usr/share/uwsm/env.d/10-omarchy"
  install -Dm644 default/fontconfig/conf.avail/50-omarchy.conf "$pkgdir/usr/share/fontconfig/conf.avail/50-omarchy.conf"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -s /usr/share/fontconfig/conf.avail/50-omarchy.conf "$pkgdir/etc/fonts/conf.d/50-omarchy.conf"
  install -Dm644 default/xdg-terminal-exec/hyprland-xdg-terminals.list "$pkgdir/usr/share/xdg-terminal-exec/hyprland-xdg-terminals.list"
  install -Dm644 default/applications/mimeapps.list "$pkgdir/usr/share/applications/mimeapps.list"
  install -Dm644 default/wayland-sessions/omarchy.desktop "$pkgdir/usr/share/wayland-sessions/omarchy.desktop"
  install -d "$pkgdir/usr/share/sddm/themes" "$pkgdir/etc/sddm.conf.d"
  cp -a default/sddm/omarchy "$pkgdir/usr/share/sddm/themes/"
  install -Dm644 default/sddm/hyprland.lua "$pkgdir/usr/share/sddm/hyprland.lua"
  cp etc/sddm.conf.d/*.conf "$pkgdir/etc/sddm.conf.d/"
  install -Dm644 default/fonts/omarchy/omarchy.ttf "$pkgdir/usr/share/fonts/omarchy/omarchy.ttf"
  install -Dm644 etc/fastfetch/config.jsonc "$pkgdir/etc/fastfetch/config.jsonc"
  install -Dm644 etc/profile.d/omarchy.sh "$pkgdir/etc/profile.d/omarchy.sh"
  for service in omarchy-fcitx5 bt-agent; do
    install -Dm644 "default/systemd/user/$service.service" "$pkgdir/usr/lib/systemd/user/$service.service"
  done
  for binary in omarchy-debug omarchy-debug-idle omarchy-upload-log; do
    install -Dm755 "bin/$binary" "$pkgdir/usr/bin/$binary"
  done
  for asset in logo.txt logo.svg icon.txt icon.png; do
    install -Dm644 "$asset" "$pkgdir/usr/share/omarchy/$asset"
  done
  install -Dm644 icon.png "$pkgdir/usr/share/pixmaps/omarchy.png"
  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/omarchy.png"
  install -Dm644 logo.txt "$pkgdir/etc/skel/.config/omarchy/branding/screensaver.txt"
  install -Dm644 icon.txt "$pkgdir/etc/skel/.config/omarchy/branding/about.txt"
  install -d "$pkgdir/etc/skel/.config/btop/themes"
  ln -s ../../../.local/state/omarchy/current/theme/btop.theme "$pkgdir/etc/skel/.config/btop/themes/current.theme"
  install -Dm644 default/hypr/toggles/flags.lua "$pkgdir/etc/skel/.local/state/omarchy/toggles/hypr/flags.lua"
  install -Dm644 default/tensaku/state.toml "$pkgdir/etc/skel/.local/state/tensaku/state.toml"
  install -Dm644 default/bashrc "$pkgdir/usr/share/omarchy/etc-overrides/dot.bashrc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omarchy-psx-settings/LICENSE"
}

package_omarchy-psx-provisioning() {
  depends=('desktop-file-utils' 'e2fsprogs' 'git' 'gum' 'omarchy-psx=4.0.0-1'
           'openssh' 'shadow' 'sudo' 'systemd' 'tzdata' 'util-linux' 'xdg-user-dirs' 'xdg-utils')
  conflicts=('omarchy-ps4-provisioning')
  backup=('etc/sudoers.d/10-omarchy-psx-wheel')
  for command in omarchy-psx-provision-owner omarchy-psx-finalize-owner; do
    install -Dm755 "$srcdir/$command" "$pkgdir/usr/bin/$command"
  done
  install -Dm644 "$srcdir/timezone-picker.sh" "$pkgdir/usr/lib/omarchy-psx/timezone-picker.sh"
  install -Dm644 "$srcdir/omarchy-psx-provision-owner.service" "$pkgdir/usr/lib/systemd/system/omarchy-psx-provision-owner.service"
  install -Dm644 "$srcdir/20-omarchy-psx-owner-gate.conf" "$pkgdir/usr/lib/systemd/system/sddm.service.d/20-omarchy-psx-owner-gate.conf"
  install -Dm440 "$srcdir/10-omarchy-psx-wheel" "$pkgdir/etc/sudoers.d/10-omarchy-psx-wheel"
  install -Dm644 "$srcdir/20-omarchy-psx-sshd.conf" "$pkgdir/etc/ssh/sshd_config.d/20-omarchy-psx.conf"
  install -Dm644 "$srcdir/omarchy/LICENSE" "$pkgdir/usr/share/licenses/omarchy-psx-provisioning/LICENSE"
}
