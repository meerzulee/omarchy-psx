#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Meerzulee
"""Fetch an immutable sibling kernel checkout; never change an existing clone."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "manifests/kernel-source.json"


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def git(*args):
    return subprocess.check_output(["git", *map(str, args)], text=True,
                                   stderr=subprocess.STDOUT, timeout=300).strip()


def setup(destination, revision=None, invoke=git):
    record = json.loads(MANIFEST.read_text())
    require(record["schema"] == 1 and record["repository"] ==
            "https://github.com/meerzulee/linux-psx.git", "Source manifest differs")
    revision = revision if revision is not None else record["revision"]
    require(isinstance(revision, str) and re.fullmatch(r"[0-9a-f]{40}", revision),
            "An immutable 40-character kernel commit is required; use the recorded pin or a full explicit revision")
    destination = destination.absolute()
    require(not destination.is_symlink(), "Destination must not be a symlink")
    if destination.exists():
        require((destination / ".git").exists(), "Destination exists and is not a Git checkout")
        require(invoke("-C", destination, "remote", "get-url", "origin") == record["repository"],
                "Existing clone has a different origin; leave it untouched")
        require(invoke("-C", destination, "rev-parse", "HEAD") == revision,
                "Existing checkout has a different commit; preserve it and choose another destination")
        require(not invoke("-C", destination, "status", "--porcelain"),
                "Existing checkout has local work; preserve it and choose another destination")
        return "Verified existing unchanged kernel checkout: " + str(destination)
    require(destination.parent.is_dir(), "Create the workspace parent directory first")
    temporary = Path(tempfile.mkdtemp(prefix=".linux-psx-fetch-", dir=destination.parent))
    try:
        invoke("clone", "--no-checkout", "--filter=blob:none", record["repository"], temporary)
        invoke("-C", temporary, "fetch", "--depth=1", "origin", revision)
        invoke("-C", temporary, "checkout", "--detach", revision)
        require(invoke("-C", temporary, "rev-parse", "HEAD") == revision, "Fetched revision differs")
        require((temporary / "targets" / (record["target"] + ".env")).is_file(),
                "Pinned commit does not contain the expected kernel target")
        require(not destination.exists() and not destination.is_symlink(), "Destination appeared; preserve it")
        os.rename(temporary, destination)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)  # Exclusively created temporary checkout only.
    return "Created pinned kernel checkout: " + str(destination)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--destination", type=Path, default=ROOT.parent / "linux-psx")
    parser.add_argument("--revision", help="Explicit full kernel commit; overrides the recorded pin")
    args = parser.parse_args()
    try:
        print(setup(args.destination, args.revision))
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        parser.exit(1, "Source handoff refused: " + str(error) + "\n")
