#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Offline checks for common console package imports and the PS5 image profile."""
import hashlib
import json
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parents[1]
record = json.loads((ROOT / "provenance/ps5-image-import.json").read_text())
for item in record["imports"]:
    for name, key in (("source", "source_sha256"), ("destination", "sha256")):
        p = (ROOT / item[name]).resolve()
        if not p.is_relative_to(ROOT) or hashlib.sha256(p.read_bytes()).hexdigest() != item[key]:
            raise ValueError(f"console package source differs: {item[name]}")
recipe = (ROOT / "packages/omarchy-psx/PKGBUILD").read_text()
names = re.findall(r"'([^']+)'", re.search(r"source=\((.*?)\)\n", recipe, re.S)[1])
sums = re.findall(r"'([^']+)'", re.search(r"sha256sums=\((.*?)\)\n", recipe, re.S)[1])
if sums[0] != "SKIP" or len(sums) != len(names) + 1:
    raise ValueError("package sources/checksum list differ")
for name, expected in zip(names, sums[1:]):
    if hashlib.sha256((ROOT / "packages/omarchy-psx" / name).read_bytes()).hexdigest() != expected:
        raise ValueError(f"package source checksum differs: {name}")
profile = json.loads((ROOT / "manifests/ps5-image.json").read_text())
if (profile["omarchy_commit"] != record["omarchy_commit"] or
        "root=LABEL=OMARCHY-PS5" not in profile["cmdline"] or profile["vram_mib"] != 512):
    raise ValueError("PS5 package/boot profile identities differ")
for item in profile["firmware"]:
    if not re.fullmatch(r"[0-9a-f]{64}", item["sha256"]) or "753c7936dcb079bfeaaa0bb19dfc495744266500/" not in item["url"]:
        raise ValueError("firmware identity must be immutable")
print(f"PASS: {len(record['imports'])} console imports, {len(names)} package inputs and PS5 image profile")
