#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Verify a complete kernel/module input set without executing target code."""
import argparse
import hashlib
from pathlib import Path
import re


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            result.update(chunk)
    return result.hexdigest()


def verify(directory, expected_release=None, expected_kernel=None, expected_modules=None):
    directory = directory.resolve(strict=True)
    release = (directory / "version.txt").read_text().strip()
    if not re.fullmatch(r"[0-9][A-Za-z0-9._+\-]{0,127}", release):
        raise ValueError("invalid kernel release")
    if expected_release and release != expected_release:
        raise ValueError("kernel release differs from the selected historical profile")
    checksums = {}
    for line in (directory / "SHA256SUMS").read_text().splitlines():
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9._+\-]+)", line)
        if not match or match[2] in checksums:
            raise ValueError("malformed or duplicate kernel checksum entry")
        checksums[match[2]] = match[1]
    module_name = f"modules-{release}.tar.zst"
    required = ["version.txt", "bzImage", module_name]
    # Native Linux psX output includes config and manifest. Historical outputs
    # can omit them, but present metadata must agree and be checksum-covered.
    for name in ("config", "manifest.txt"):
        if (directory / name).exists():
            required.append(name)
    for name in required:
        path = directory / name
        if path.is_symlink() or not path.is_file() or name not in checksums:
            raise ValueError(f"missing regular checksum-covered input: {name}")
        if digest(path) != checksums[name]:
            raise ValueError(f"kernel input checksum differs: {name}")
    if expected_kernel and checksums["bzImage"] != expected_kernel:
        raise ValueError("kernel digest differs from the selected historical profile")
    if expected_modules and checksums[module_name] != expected_modules:
        raise ValueError("module digest differs from the selected historical profile")
    if (directory / "manifest.txt").exists():
        pairs = {}
        for line in (directory / "manifest.txt").read_text().splitlines():
            key, separator, value = line.partition("=")
            if not separator or key in pairs:
                raise ValueError("malformed kernel build manifest")
            pairs[key] = value
        if pairs.get("kernel_release") != release:
            raise ValueError("build manifest kernel release differs")
        if "config" in required and pairs.get("config_sha256") != checksums["config"]:
            raise ValueError("build manifest config digest differs")
    return release


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", type=Path)
    parser.add_argument("--expected-release")
    parser.add_argument("--expected-kernel-sha256")
    parser.add_argument("--expected-modules-sha256")
    args = parser.parse_args()
    try:
        release = verify(args.directory, args.expected_release,
                         args.expected_kernel_sha256, args.expected_modules_sha256)
        print(f"PASS: checksum-covered kernel and whole modules for {release}")
    except (OSError, ValueError) as error:
        parser.exit(1, f"Kernel inputs refused: {error}\n")
