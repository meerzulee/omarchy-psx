pkgname=omarchy-ps4-provisioning
pkgver=4.0.0
pkgrel=22
pkgdesc='External-root first-boot owner setup for Omarchy PS4'
arch=('any')
url='https://github.com/meerzulee/omarchy-ps4'
license=('MIT')

depends=(
  'desktop-file-utils'
  'e2fsprogs'
  'git'
  'gum'
  'omarchy-ps4=4.0.0-10'
