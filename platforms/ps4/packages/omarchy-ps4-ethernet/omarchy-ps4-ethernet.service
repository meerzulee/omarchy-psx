[Unit]
Description=Activate sealed PS4 Baikal continuous Ethernet candidate
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=/etc/omarchy-ps4/ethernet-candidate.json
ConditionKernelVersion=6.18.44-ps4-baikal-mts2

[Service]
Type=oneshot
ExecStart=/usr/lib/omarchy-ps4/activate-baikal-ethernet
RemainAfterExit=yes
TimeoutStartSec=75
UMask=0077

[Install]
WantedBy=multi-user.target
