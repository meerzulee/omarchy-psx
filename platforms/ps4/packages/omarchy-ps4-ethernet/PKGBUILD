package() {
  install -Dm755 activate-baikal-ethernet \
    "$pkgdir/usr/lib/omarchy-ps4/activate-baikal-ethernet"
  install -Dm644 omarchy-ps4-ethernet.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-ps4-ethernet.service"
  install -Dm644 PS4Ethernet.nmconnection.in \
    "$pkgdir/usr/share/omarchy-ps4/PS4Ethernet.nmconnection.in"
