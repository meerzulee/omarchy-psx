#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
fpkg_dir=$(cd -- "$script_dir/.." && pwd)
repo_dir=$(cd -- "$fpkg_dir/.." && pwd)
workspace_dir=$(cd -- "$repo_dir/../../.." && pwd)

profile=accepted
case ${1:-} in
  --ultrawide)
    profile=ultrawide
    shift
    ;;
  --partitioned)
    profile=partitioned
    shift
    ;;
esac
if (( $# > 0 )); then
  printf 'Usage: %s [--ultrawide|--partitioned]\n' "$0" >&2
  exit 2
fi

initramfs_source=$repo_dir/output/xfce-baseline/initramfs.cpio.gz
inventory_profile=private-kernel-manager
inventory_reason='loader license and USB image digests are unresolved'
if [[ $profile == ultrawide ]]; then
  kernel_source=${PS4_HISTORICAL_KERNEL_IMAGE:-}
  bootargs_source=$fpkg_dir/bootargs/6.18-baikal-ultrawide-3440x1440.txt
  manifest_source=$fpkg_dir/manifest/release-manifest.ultrawide-dev.json
  stage_dir=$fpkg_dir/vendor/internal-boot-ultrawide
  inventory=$fpkg_dir/vendor/provenance/internal-boot-set-ultrawide.json
  kernel_size=11244544
  kernel_sha256=9d0fe91771eea8e2e6969ce46417bc8e3497dc8ccec383826edb1160f2f0b270
  initramfs_size=1686552
  initramfs_sha256=841b7a1b59ad0c53d97be49fb4369ba7918158df0fc557f9620fd3bddddb15ef
  bootargs_size=465
  bootargs_sha256=445b9584db9815c793576193d1f7afc33e99e02115938396ee19c5ea23c5292f
  release=omarchy-ps4-4.0.0-baikal-b1-ultrawide-dev1
elif [[ $profile == partitioned ]]; then
  kernel_source=${PS4_HISTORICAL_KERNEL_IMAGE:-}
  initramfs_source=$repo_dir/output/partitioned-dev/initramfs.cpio.gz
  bootargs_source=$fpkg_dir/bootargs/6.18-baikal-partitioned-usb.txt
  manifest_source=$fpkg_dir/manifest/release-manifest.partitioned-dev.json
  stage_dir=$fpkg_dir/vendor/internal-boot-partitioned
  inventory=$fpkg_dir/vendor/provenance/internal-boot-set-partitioned.json
  inventory_profile=private-kernel-manager-partitioned
  inventory_reason='private partitioned development profile; hardware acceptance and USB image digests are unresolved'
  kernel_size=11060224
  kernel_sha256=b7c8b9d67c600ee08b2321f7f4fac08c506791b0ab9c3f3d01598a90471a9de5
  initramfs_size=1686082
  initramfs_sha256=31e793671aca8b595e130fa9d1ba5a93f0d777ee45843eb1aa3925294b0dc353
  bootargs_size=494
  bootargs_sha256=dabd2779ac7f172ac3f534a93883694155d8b0c51d6fe2247597cc7fb111bb84
  release=omarchy-ps4-4.0.0-baikal-b1-partitioned-dev1
else
  kernel_source=${PS4_HISTORICAL_KERNEL_IMAGE:-}
  bootargs_source=$fpkg_dir/bootargs/6.18-baikal-internal-root.txt
  manifest_source=$fpkg_dir/manifest/release-manifest.example.json
  stage_dir=$fpkg_dir/vendor/internal-boot
  inventory=$fpkg_dir/vendor/provenance/internal-boot-set.json
  kernel_size=11060224
  kernel_sha256=b7c8b9d67c600ee08b2321f7f4fac08c506791b0ab9c3f3d01598a90471a9de5
  initramfs_size=1686508
  initramfs_sha256=824530e22392376d5fc27994a9ccff97f0442b7a41681155f46e183f892365ae
  bootargs_size=502
  bootargs_sha256=8064d91f286d4275dac08e2fae29e43fbf745ea7be15f797edbbd0e5036a4930
  release=omarchy-ps4-4.0.0-baikal-b1-beta1
fi

verify() {
  local source_file=$1 expected_size=$2 expected_sha256=$3 label=$4
  [[ -f $source_file ]] || {
    printf 'internal-boot-set: missing %s: %s\n' "$label" "$source_file" >&2
    exit 1
  }
  local actual_size actual_sha256
  actual_size=$(stat -f %z "$source_file" 2>/dev/null || stat -c %s "$source_file")
  actual_sha256=$(shasum -a 256 "$source_file" | awk '{print $1}')
  [[ $actual_size == "$expected_size" ]] || {
    printf 'internal-boot-set: %s size mismatch: expected=%s actual=%s\n' \
      "$label" "$expected_size" "$actual_size" >&2
    exit 1
  }
  [[ $actual_sha256 == "$expected_sha256" ]] || {
    printf 'internal-boot-set: %s digest mismatch\nexpected: %s\nactual:   %s\n' \
      "$label" "$expected_sha256" "$actual_sha256" >&2
    exit 1
  }
}

[[ -n $kernel_source ]] || {
  printf '%s\n' \
    'internal-boot-set: this frozen profile requires its original exact-hash kernel.' \
    'Set PS4_HISTORICAL_KERNEL_IMAGE to an explicitly acquired historical bzImage.' \
    'Do not substitute linux-psx output; see platforms/ps4/docs/IMPORT-NOTES.md.' >&2
  exit 1
}
initramfs_source=${PS4_HISTORICAL_INITRAMFS:-$initramfs_source}
verify "$kernel_source" "$kernel_size" "$kernel_sha256" kernel
verify "$initramfs_source" "$initramfs_size" "$initramfs_sha256" initramfs
verify "$bootargs_source" "$bootargs_size" "$bootargs_sha256" bootargs
"$fpkg_dir/tools/validate-manifest" "$manifest_source" >/dev/null

rm -rf "$stage_dir"
mkdir -p "$stage_dir" "$(dirname -- "$inventory")"
install -m 0644 "$kernel_source" "$stage_dir/bzImage"
install -m 0644 "$initramfs_source" "$stage_dir/initramfs.cpio.gz"
install -m 0644 "$bootargs_source" "$stage_dir/bootargs.txt"
printf '1024\n' >"$stage_dir/vram.txt"
install -m 0644 "$manifest_source" "$stage_dir/release.json"

verify "$stage_dir/vram.txt" 5 \
  4f71bb761ace37c88826cd8cc1c948e1cf5b5d0cd153dc651a6efdb3dfb9f2b1 vram

printf '%s\n' \
  '{' \
  '  "schema": 1,' \
  "  \"profile\": \"$inventory_profile\"," \
  '  "release_eligible": false,' \
  "  \"reason\": \"$inventory_reason\"," \
  '  "destination": "/data/linux/boot",' \
  "  \"release\": \"$release\"," \
  '  "vram_mb": 1024,' \
  '  "contents": {' \
  "    \"kernel\": {\"size\": $kernel_size, \"sha256\": \"$kernel_sha256\"}," \
  "    \"initramfs\": {\"size\": $initramfs_size, \"sha256\": \"$initramfs_sha256\"}," \
  "    \"bootargs\": {\"size\": $bootargs_size, \"sha256\": \"$bootargs_sha256\"}," \
  '    "vram": {"size": 5, "sha256": "4f71bb761ace37c88826cd8cc1c948e1cf5b5d0cd153dc651a6efdb3dfb9f2b1"}' \
  '  }' \
  '}' >"$inventory"

printf 'internal-boot-set: staged %s private inputs in %s\n' "$profile" "$stage_dir"
printf '%s\n' 'internal-boot-set: release eligible: no'
