 using namespace GLB;
 
+// Private diagnostic only: normal warmup, then first timed shadow cascade 0.
+// glFinish changes timing. Exit 86 is a diagnostic cut, never a benchmark score.
+static bool psx_shadow_probe = false;
+static bool psx_shadow_started = false;
+static unsigned psx_shadow_draw = 0;
+static void psx_shadow_mark(const char *stage)
+{
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    std::fprintf(stderr, "PSX_SHADOW0 us=%lld draw=%u %s\n", (long long)us, psx_shadow_draw, stage);
+    std::fflush(stderr);
+}
+static void psx_shadow_before_draw(const char *mesh, const char *material,
+                                  GLuint program, GLenum primitive,
+                                  unsigned count, unsigned instances, bool tess, bool geometry)
+{
+    GLint vao=0, ebo=0, vbo=0, fbo=0, ebo_bytes=0;
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &ebo);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &vbo);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fbo);
+    if (ebo) glGetBufferParameteriv(GL_ELEMENT_ARRAY_BUFFER, GL_BUFFER_SIZE, &ebo_bytes);
+    ++psx_shadow_draw;
+    std::fprintf(stderr, "PSX_SHADOW0 DRAW_STATE mesh=%s material=%s program=%u primitive=%u count=%u instances=%u tes=%u gs=%u vao=%d ebo=%d ebo_bytes=%d vbo=%d fbo=%d\n",
+        mesh, material, program, primitive, count, instances, unsigned(tess), unsigned(geometry), vao, ebo, ebo_bytes, vbo, fbo);
+    psx_shadow_mark("DRAW_BEGIN");
+}
+
+
 #define TESSELLATED_SHADOWS 1
 #define DEBUG_SHADOW 0
 
