#!/usr/bin/env python3
"""Run resume guards with isolated block nodes and mocked device I/O.

Linux root is needed only to create inert block-node fixtures. Run inside the
existing OrbStack container; no host block device is passed into it.
"""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

REPO = Path(__file__).resolve().parents[1]
SERIAL = "OMARCHY_TEST_123"
ROOT_UUID = "e5145501-a845-4698-bf6f-355bb544b52c"
BOOT_UUID = "A3C7-0617"

MOCK = r'''#!/usr/bin/env python3
import json,os,sys,shutil
from pathlib import Path
tool=Path(sys.argv[0]).name; args=sys.argv[1:]
root=Path(os.environ['TEST_ROOT']); scenario=os.environ['TEST_SCENARIO']
disk=os.environ['TEST_DISK']; host=os.environ['TEST_HOST']; serial=os.environ['TEST_SERIAL']
with (root/'calls').open('a') as log:log.write(json.dumps([tool]+args)+'\n')
state=json.loads((root/'mounts').read_text())
def save(): (root/'mounts').write_text(json.dumps(state))
if tool=='lsblk':
    flag=args[0]; field=args[1] if len(args)>1 else ''; node=args[-1]
    if field=='TYPE':print('disk' if node in [disk,host] else 'part')
    elif field=='TRAN':print('usb')
    elif field=='SERIAL':print(serial)
    elif field=='MAJ:MIN':print('7:250')
    elif field=='LOG-SEC':print('512')
    elif field=='SIZE':print('123983626240')
    elif field=='NAME':
        print(host if flag=='-snrpo' else '\n'.join([disk,disk+'1',disk+'2']))
    elif field=='MOUNTPOINTS':print('\n'.join(state.values()))
    elif flag=='-o':print('isolated USB fixture')
    else:raise SystemExit('unknown lsblk arguments: '+repr(args))
elif tool=='findmnt':
    if 'SOURCE' in args:print(host)
    elif '-S' in args:
        value=state.get(args[args.index('-S')+1]);
        if value:print(value)
        else:sys.exit(1)
    else:raise SystemExit('unknown findmnt arguments: '+repr(args))
elif tool=='swapon':pass
elif tool=='blkid':
    key=args[args.index('-s')+1]; boot=args[-1].endswith('1')
    if key=='UUID':
        value='A3C7-0617' if boot else 'e5145501-a845-4698-bf6f-355bb544b52c'
        if scenario=='wrong-uuid' and not boot:value='00000000-0000-0000-0000-000000000000'
        print(value)
    elif key=='TYPE':print('vfat' if boot else 'ext4')
    elif key=='LABEL':print('PS4BOOT' if boot else 'OMARCHY-PS4')
elif tool=='sfdisk':
    if args!=['--json',disk]:raise SystemExit('forbidden partition write')
    json.dump({'partitiontable':{'device':disk,'label':'dos','unit':'sectors','sectorsize':512,
      'partitions':[{'node':disk+'1','start':2048,'size':8388608,'type':'c','bootable':True},
                    {'node':disk+'2','start':8390656,'size':233764864,'type':'83'}]}},sys.stdout)
elif tool=='udevadm':
    if args[0]=='info':
        rule=root/'rules'/('99-omarchy-ps4-install-'+serial+'.rules')
        assert rule.read_text()==f'SUBSYSTEM=="block", ENV{{ID_BUS}}=="usb", ENV{{ID_SERIAL_SHORT}}=="{serial}", ENV{{UDISKS_IGNORE}}="1"\n'
        print('ID_BUS=usb\nID_SERIAL_SHORT='+serial)
        if scenario!='guard-failed':print('UDISKS_IGNORE=1')
elif tool=='umount':
    target=args[-1]
    if target in state:del state[target]
    else:
        for node,path in list(state.items()):
            if path==target:
                for child in Path(target).iterdir():
                    if child.is_dir():shutil.rmtree(child)
                    else:child.unlink()
                del state[node]
    save()
elif tool=='mount':
    node,target=args[-2:]; state[node]=target;save()
    if node.endswith('2'):
        (Path(target)/'lost+found').mkdir(exist_ok=True)
        if scenario=='populated-root':(Path(target)/'existing-user-data').write_text('keep')
        if scenario=='populated-lost-found':(Path(target)/'lost+found/recovered-file').write_text('keep')
    elif scenario=='populated-boot':(Path(target)/'existing-file').write_text('keep')
elif tool in ['e2fsck','fsck.fat']:pass
elif tool in ['wipefs','mkfs.vfat','mkfs.ext4']:raise SystemExit('forbidden format in resume')
else:raise SystemExit('unknown mock: '+tool)
'''


@unittest.skipUnless(os.geteuid() == 0 and os.uname().sysname == "Linux", "Linux root fixture required")
class ResumeGuards(unittest.TestCase):
    def exercise(self, scenario):
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            disk = f"/dev/omarchytest{os.getpid()}disk"
            host = f"/dev/omarchytest{os.getpid()}host"
            stable = Path(f"/dev/disk/by-id/usb-{SERIAL}-0:0")
            stable.parent.mkdir(parents=True, exist_ok=True)
            nodes = [Path(disk), Path(disk+'1'), Path(disk+'2'), Path(host)]
            try:
                for index, node in enumerate(nodes):os.mknod(node, 0o60600, os.makedev(7,250+index))
                stable.symlink_to(disk)
                sysfs = root/'devices/usb1/block'/Path(disk).name
                sysfs.mkdir(parents=True); links=root/'sys';links.mkdir()
                (links/Path(disk).name).symlink_to(sysfs)
                (root/'mounts').write_text(json.dumps({disk+'1':'/media/boot',disk+'2':'/media/root'}))
                (root/'calls').touch(); (root/'mnt').mkdir();(root/'rules').mkdir()
                tools=root/'tools';tools.mkdir(); driver=tools/'mock';driver.write_text(MOCK);driver.chmod(0o755)
                for name in ['lsblk','findmnt','swapon','blkid','sfdisk','udevadm','umount','mount','e2fsck','fsck.fat','wipefs','mkfs.vfat','mkfs.ext4','zstd']:
                    (tools/name).symlink_to(driver)
                archive=root/'rootfs.tar.zst';archive.write_bytes(b'fixture archive; never extracted')
                Path(str(archive)+'.manifest').write_text(
                    f'archive_sha256={hashlib.sha256(archive.read_bytes()).hexdigest()}\narchive_size={archive.stat().st_size}\n'
                    'root_layout=partitioned-usb\nkernel_release=6.18.44-ps4-baikal\n'
                    'modules_sha256=1c03bb14635ce6099dc81b43d75cb63050a44909944101ffc319dcf32943fcd7\n')
                package=root/'launcher.pkg';package.write_bytes(b'fixture')
                source=(REPO/'scripts/install-partitioned-usb-linux').read_text()
                source=source.replace('repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)',f'repo_dir={REPO}')
                source=source.replace('/sys/class/block/',str(links)+'/').replace('/run/udev/rules.d',str(root/'rules'))
                source=source.replace('/run/lock/omarchy-ps4-usb-',str(root/'lock-')).replace('/mnt/omarchy-ps4-partitioned.',str(root/'mnt/installation.'))
                # End at the first data-copy operation; all guards above run unchanged.
                source=source.replace("printf 'Extracting the verified Omarchy system; keep the USB connected.\\n'", "printf 'COPY_REACHED\\n'; exit 0")
                script=root/'installer';script.write_text(source)
                result=subprocess.run(['bash',str(script),'--device',str(stable),'--serial',SERIAL,
                    '--rootfs',str(archive),'--boot-set',str(REPO/'fpkg/vendor/internal-boot-partitioned'),
                    '--launcher',str(package),'--resume','--expect-root-uuid',ROOT_UUID,'--expect-boot-uuid',BOOT_UUID,'--apply'],
                    input=f'RESUME {stable}\n',text=True,capture_output=True,
                    env={**os.environ,'PATH':str(tools)+':'+os.environ['PATH'],'TEST_ROOT':str(root),
                         'TEST_SCENARIO':scenario,'TEST_DISK':disk,'TEST_HOST':host,'TEST_SERIAL':SERIAL})
                calls=[json.loads(line) for line in (root/'calls').read_text().splitlines()]
                self.assertFalse(any(call[0] in ['mkfs.ext4','mkfs.vfat','wipefs'] for call in calls))
                self.assertFalse(any(call[0]=='sfdisk' and call[1]!='--json' for call in calls))
                self.assertEqual(list((root/'rules').iterdir()),[],'temporary rule must be removed')
                return result
            finally:
                stable.unlink(missing_ok=True)
                for node in nodes:node.unlink(missing_ok=True)

    def test_empty_matching_filesystems_resume_without_format(self):
        result=self.exercise('valid')
        self.assertEqual(result.returncode,0,result.stdout+result.stderr)
        self.assertIn('COPY_REACHED',result.stdout)

    def test_reject_mismatched_or_populated_filesystems_and_guard_failure(self):
        cases={'wrong-uuid':'resume filesystem UUIDs differ',
               'populated-root':'root filesystem is not empty',
               'populated-lost-found':'lost+found is not an empty directory',
               'populated-boot':'boot filesystem is not empty',
               'guard-failed':'automount exclusion did not apply'}
        for scenario,message in cases.items():
            with self.subTest(scenario=scenario):
                result=self.exercise(scenario)
                self.assertNotEqual(result.returncode,0,result.stdout+result.stderr)
                self.assertIn(message,result.stderr,result.stdout+result.stderr)
                self.assertNotIn('COPY_REACHED',result.stdout)


if __name__=='__main__':unittest.main()
