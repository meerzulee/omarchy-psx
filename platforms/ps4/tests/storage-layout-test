#!/usr/bin/env python3
"""Exercise first-boot storage guards against isolated, non-I/O block fixtures.

Run as root inside the existing OrbStack test container. Only filesystem paths
are redirected; the packaged program's decisions and arithmetic run unchanged.
"""
import os
import subprocess
import tempfile
import unittest
from pathlib import Path

SOURCE = Path(__file__).resolve().parents[1] / "packages/omarchy-ps4-provisioning/omarchy-ps4-grow-root"


@unittest.skipUnless(os.geteuid() == 0 and os.uname().sysname == "Linux", "Linux root fixture required")
class StorageGuards(unittest.TestCase):
    def run_fixture(self, scenario, whole=False):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            state = root / "state"
            (state / "provisioning").mkdir(parents=True)
            (state / "provisioning/pending").touch()
            layout = "whole-device-filesystem" if whole else "partitioned-usb"
            (state / "image-layout").write_text(
                f"schema=1\nlayout={layout}\nfilesystem=ext4\nlabel=OMARCHY-PS4\n"
                + ("auto_grow=1\nbase_image_bytes=32000000000\n" if whole else
                   f"auto_grow={1 if scenario == 'grow-forbidden' else 0}\nboot_bytes=4294967296\n"))
            devices = root / "dev"
            devices.mkdir()
            sysfs = root / ("devices/pci/ata/block/sda" if scenario == "internal" else "devices/pci/usb1/block/sda")
            sysfs.mkdir(parents=True)
            disk_sectors = 242155520
            (sysfs / "size").write_text(str(disk_sectors))
            links = root / "sys"
            links.mkdir()
            (links / "sda").symlink_to(sysfs)
            os.mknod(devices / "sda", 0o60600, os.makedev(7, 250))
            if not whole:
                for number in (1, 2):
                    part = sysfs / f"sda{number}"
                    part.mkdir()
                    (part / "partition").write_text(str(number))
                    (part / "start").write_text(str(2048 if number == 1 else 8390656))
                    size = (8388607 if scenario == "wrong-boot-size" else 8388608) if number == 1 else disk_sectors - 8390656
                    (part / "size").write_text(str(size))
                    (links / f"sda{number}").symlink_to(part)
                    os.mknod(devices / f"sda{number}", 0o60600, os.makedev(7, 250 + number))
                if scenario == "extra-partition":
                    (sysfs / "sda3").mkdir()
                    (sysfs / "sda3/partition").write_text("3")
                if scenario == "short-root":
                    (sysfs / "sda2/size").write_text(str(disk_sectors - 8390657))
            tools = root / "tools"
            tools.mkdir()
            commands = {
                "findmnt": f"printf '%s\\n' '{devices}/sda{'' if whole else '2'}'",
                "lsblk": "case $* in *TYPE*) [[ ${*: -1} == *sda ]] && echo disk || echo part ;; *TRAN*) echo usb ;; esac",
                "blkid": "case $* in *LABEL*) [[ ${*: -1} == *sda1 ]] && echo PS4BOOT || echo OMARCHY-PS4 ;; *TYPE*) [[ ${*: -1} == *sda1 ]] && echo vfat || echo ext4 ;; esac",
                "blockdev": f"[[ $1 == --getss ]] && echo 512 || echo {((disk_sectors if whole else disk_sectors - 8390656) * 512)}",
                "dumpe2fs": f"bytes={((disk_sectors if whole else disk_sectors - 8390656) * 512)}\n"
                    + ("[[ -e $TEST_ROOT/resized ]] || bytes=32000000000\n" if whole else "")
                    + ("bytes=$((bytes - 33554432))\n" if scenario == "small-filesystem" else "")
                    + "printf 'Block count: %s\\nBlock size: 4096\\n' $((bytes / 4096))",
                "resize2fs": 'touch "$TEST_ROOT/resized"',
            }
            for name, body in commands.items():
                path = tools / name
                path.write_text("#!/usr/bin/env bash\nset -e\n" + body + "\n")
                path.chmod(0o755)
            script = SOURCE.read_text().replace("state_dir=/var/lib/omarchy-ps4", f"state_dir={state}")
            script = script.replace("log_file=/var/log/omarchy-ps4-grow-root.log", f"log_file={root}/log")
            script = script.replace("/sys/class/block/", str(links) + "/").replace("/dev/", str(devices) + "/")
            path = root / "grow-root"
            path.write_text(script)
            result = subprocess.run(["bash", str(path)], env={**os.environ, "PATH": str(tools) + ":" + os.environ["PATH"], "TEST_ROOT": str(root)}, capture_output=True, text=True)
            return result, (state / "storage-expanded").exists(), (root / "resized").exists()

    def test_partitioned_ready_without_resize(self):
        result, marker, resized = self.run_fixture("valid")
        self.assertEqual(result.returncode, 0, result.stderr + result.stdout)
        self.assertTrue(marker)
        self.assertFalse(resized)

    def test_whole_device_still_expands(self):
        result, marker, resized = self.run_fixture("valid", whole=True)
        self.assertEqual(result.returncode, 0, result.stderr + result.stdout)
        self.assertTrue(marker and resized)

    def test_reject_invalid_layout_without_resize_or_marker(self):
        for scenario in ("internal", "grow-forbidden", "wrong-boot-size", "extra-partition", "short-root", "small-filesystem"):
            with self.subTest(scenario=scenario):
                result, marker, resized = self.run_fixture(scenario)
                self.assertNotEqual(result.returncode, 0, result.stdout)
                self.assertFalse(marker or resized)


if __name__ == "__main__":
    unittest.main()
